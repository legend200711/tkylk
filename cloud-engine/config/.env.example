# ─────────────────────────────────────────────────────────────────────────────
# 24-HOUR CLOUD ENGINE — Example Environment Variables
# cloud-engine/config/.env.example
#
# Copy this file to .env (NEVER commit .env to source control).
# All values below are PLACEHOLDERS — replace with real values server-side only.
#
# These variables are consumed by the Cloudflare Worker or a Node.js server.
# They must NEVER be embedded in client-side JavaScript or browser code.
#
# Stage 3 additions: RTMP/RTMPS stream destination configuration.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (server-side service account — NOT the public config) ────────────
# The public Firebase config (apiKey, projectId, etc.) lives in firebase-client.js
# and is safe to commit. The SERVICE ACCOUNT KEY below is NOT public.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"PLACEHOLDER",...}

# ── YouTube RTMPS Destination (Stage 3) ──────────────────────────────────────
# Stream keys are secrets. Never put them in browser JS, logs, or commits.
# The streamKeyEnvVar in destination config points to this variable name.
# RTMPS (SSL) is preferred over plain RTMP.
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com:443/live2
# Plain RTMP fallback (less secure, use RTMPS where possible):
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# ── Custom RTMP Destination (Stage 3) ────────────────────────────────────────
# Use any RTMP-compatible server (nginx-rtmp, node-media-server, SRS, etc.)
# CUSTOM_RTMP_STREAM_KEY=your-custom-stream-key
# CUSTOM_RTMP_URL=rtmp://your-server.example.com/live

# ── Local RTMP Test Destination (Stage 3 testing) ────────────────────────────
# For end-to-end testing without a real destination. Run nginx-rtmp or
# node-media-server locally and set:
# LOCAL_RTMP_STREAM_KEY=test-key
# LOCAL_RTMP_URL=rtmp://127.0.0.1/live

# ── Cloud Engine Channel ──────────────────────────────────────────────────────
CLOUD_ENGINE_CHANNEL_ID=ALTV
CLOUD_ENGINE_LOG_LEVEL=INFO

# ── Broadcast Engine Configuration (Stage 3) ─────────────────────────────────
BROADCAST_RECONNECT_INITIAL_DELAY_MS=2000
BROADCAST_RECONNECT_MAX_DELAY_MS=60000
BROADCAST_RECONNECT_MAX_ATTEMPTS=10

# ── Watchdog / Recovery (Later stage) ────────────────────────────────────────
CLOUD_ENGINE_WATCHDOG_ENABLED=false
CLOUD_ENGINE_RECOVERY_STRATEGY=restart

# ── Cloudflare Worker — Cloud Engine API (ce-api) ─────────────────────────────
# These are CE-specific secrets for the Cloud Engine Cloudflare Worker.
# DO NOT reuse Shadow Reaper secrets (SR_SERVICE_TOKENS, SR_INTERNAL_API_KEY).
# Set via: wrangler secret put <VAR_NAME>  (in the cloud-engine Worker context)

# CE Worker service tokens — JSON registry: { [token]: { system, active } }
# wrangler secret put CE_SERVICE_TOKENS
CE_SERVICE_TOKENS={"your-token-hash":{"system":"WEB_APP","active":true}}

# Allowed CORS origin for the CE Worker
# wrangler secret put CE_ALLOWED_ORIGIN
CE_ALLOWED_ORIGIN=https://your-ce-domain.com

# Firebase service account for the CE Worker (server-side only — NEVER in client JS)
# wrangler secret put CE_FIREBASE_SERVICE_ACCOUNT
CE_FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"remix-studio-4bf8a",...}

# ── Shared Infrastructure — Firebase Project ─────────────────────────────────
# Cloud Engine uses the AURENIX Firebase project (remix-studio-4bf8a).
# Shadow Reaper uses a SEPARATE Firebase project (ffr3r3223).
# DO NOT swap these project IDs between systems.
CLOUD_ENGINE_FIREBASE_PROJECT_ID=remix-studio-4bf8a
SHADOW_REAPER_FIREBASE_PROJECT_ID=ffr3r3223

# ── Cloudflare — KV Namespace (Cloud Engine) ─────────────────────────────────
# Create via: wrangler kv:namespace create CE_ENGINE_STATE
# Then add to cloudflare/wrangler.toml:
#   [[kv_namespaces]]
#   binding = "CE_ENGINE_STATE"
#   id      = "<your-kv-namespace-id>"
CE_ENGINE_STATE_KV_ID=YOUR_CE_ENGINE_STATE_KV_NAMESPACE_ID
